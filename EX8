9. Procedure Max Employees Department

Question:
Find department with maximum employees.

Code:

SQL> SET SERVEROUTPUT ON;
SQL> CREATE OR REPLACE PROCEDURE max_emp_dept IS
  2      v_dept VARCHAR2(50);
  3  BEGIN
  4      SELECT dept_name INTO v_dept
  5      FROM (
  6          SELECT dept_name, COUNT(*) cnt
  7          FROM EMPLOYEE
  8          GROUP BY dept_name
  9          ORDER BY cnt DESC
 10      )
 11      WHERE ROWNUM = 1;

 12      DBMS_OUTPUT.PUT_LINE('Department with max employees: ' || v_dept);
 13  END;
 14  /

