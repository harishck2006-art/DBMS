import javax.swing.*;
import java.awt.*;
import java.sql.*;

public class Placement extends JFrame {

    JTextField t1, t2, t3, t4;
    JButton insertBtn, updateBtn, deleteBtn, viewBtn;

    Connection con;

    public Placement() {

        setTitle("Placement Management System");
        setSize(520,420);
        setLocationRelativeTo(null);
        setLayout(new BorderLayout());

       
        JLabel title = new JLabel("Placement Management System", JLabel.CENTER);
        title.setFont(new Font("Segoe UI", Font.BOLD, 20));
        title.setBorder(BorderFactory.createEmptyBorder(15,10,10,10));
        add(title, BorderLayout.NORTH);

   
        JPanel form = new JPanel(new GridLayout(4,2,10,10));
        form.setBorder(BorderFactory.createEmptyBorder(20,40,20,40));
        form.setBackground(new Color(245,247,250)); // light clean bg

        Font f = new Font("Segoe UI", Font.PLAIN, 14);

        form.add(new JLabel("Student ID:")); 
        t1 = new JTextField(); t1.setFont(f); form.add(t1);

        form.add(new JLabel("Name:")); 
        t2 = new JTextField(); t2.setFont(f); form.add(t2);

        form.add(new JLabel("Department:")); 
        t3 = new JTextField(); t3.setFont(f); form.add(t3);

        form.add(new JLabel("GPA:")); 
        t4 = new JTextField(); t4.setFont(f); form.add(t4);

        add(form, BorderLayout.CENTER);

  
        JPanel buttons = new JPanel(new GridLayout(2,2,12,12));
        buttons.setBorder(BorderFactory.createEmptyBorder(10,40,20,40));

        insertBtn = new JButton("Insert");
        updateBtn = new JButton("Update");
        deleteBtn = new JButton("Delete");
        viewBtn   = new JButton("View");

        JButton[] btns = {insertBtn, updateBtn, deleteBtn, viewBtn};

        for(JButton b : btns){
            b.setFont(new Font("Segoe UI", Font.BOLD, 13));
            b.setFocusPainted(false);
            b.setBackground(new Color(230,235,245)); // subtle color
        }

        buttons.add(insertBtn);
        buttons.add(updateBtn);
        buttons.add(deleteBtn);
        buttons.add(viewBtn);

        add(buttons, BorderLayout.SOUTH);

      
        try {
            Class.forName("com.mysql.cj.jdbc.Driver");
            con = DriverManager.getConnection(
                "jdbc:mysql://localhost:3306/placement","root","Harish@1011");
        } catch(Exception e){
            JOptionPane.showMessageDialog(this,e);
        }

     
        insertBtn.addActionListener(e -> {
            try {
                PreparedStatement ps = con.prepareStatement(
                    "INSERT INTO STUDENT VALUES (?,?,?,?)");

                ps.setString(1, t1.getText());
                ps.setString(2, t2.getText());
                ps.setString(3, t3.getText());
                ps.setFloat(4, Float.parseFloat(t4.getText()));

                ps.executeUpdate();
                JOptionPane.showMessageDialog(this,"Inserted successfully!");

            } catch(Exception ex){
                JOptionPane.showMessageDialog(this,ex.getMessage());
            }
        });

       
        updateBtn.addActionListener(e -> {
            try {
                PreparedStatement ps = con.prepareStatement(
                    "UPDATE STUDENT SET GPA=? WHERE STUDENTID=?");

                ps.setFloat(1, Float.parseFloat(t4.getText()));
                ps.setString(2, t1.getText());

                int rows = ps.executeUpdate();

                JOptionPane.showMessageDialog(this,
                    rows>0 ? "Updated successfully!" : "ID not found!");

            } catch(Exception ex){
                JOptionPane.showMessageDialog(this,ex.getMessage());
            }
        });

   
        deleteBtn.addActionListener(e -> {
            try {
                String id = JOptionPane.showInputDialog(this,
                        "Enter Student ID to Delete:");

                if(id == null || id.trim().isEmpty()) return;

                int confirm = JOptionPane.showConfirmDialog(this,
                        "Delete ID: " + id + " ?",
                        "Confirm",
                        JOptionPane.YES_NO_OPTION);

                if(confirm != JOptionPane.YES_OPTION) return;

                PreparedStatement ps = con.prepareStatement(
                    "DELETE FROM STUDENT WHERE STUDENTID=?");

                ps.setString(1, id);

                int rows = ps.executeUpdate();

                JOptionPane.showMessageDialog(this,
                    rows>0 ? "Deleted successfully!" : "ID not found!");

            } catch(Exception ex){
                JOptionPane.showMessageDialog(this,ex.getMessage());
            }
        });

   
        viewBtn.addActionListener(e -> {
            try {
                Statement st = con.createStatement();
                ResultSet rs = st.executeQuery("SELECT * FROM STUDENT");

                StringBuilder data = new StringBuilder();
                data.append("STUDENT RECORDS\n");
                data.append("---------------------------------\n");

                while(rs.next()) {
                    data.append("ID: ").append(rs.getString(1)).append("\n")
                        .append("Name: ").append(rs.getString(2)).append("\n")
                        .append("Dept: ").append(rs.getString(3)).append("\n")
                        .append("GPA: ").append(rs.getFloat(4)).append("\n")
                        .append("---------------------------------\n");
                }

                JTextArea area = new JTextArea(data.toString());
                area.setFont(new Font("Segoe UI", Font.PLAIN, 13));
                area.setEditable(false);

                JScrollPane scroll = new JScrollPane(area);
                scroll.setPreferredSize(new Dimension(420,250));

                JOptionPane.showMessageDialog(this, scroll, 
                    "Student Records", JOptionPane.INFORMATION_MESSAGE);

            } catch(Exception ex){
                JOptionPane.showMessageDialog(this,ex.getMessage());
            }
        });

  
        addWindowListener(new java.awt.event.WindowAdapter() {
            public void windowClosing(java.awt.event.WindowEvent e) {
                try { con.close(); } catch(Exception ex){}
            }
        });

        setVisible(true);
    }

    public static void main(String[] args) {
        new Placement();
    }
}
