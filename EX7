SQL> CREATE OR REPLACE TRIGGER trg_check_stock
  2
  3  BEFORE INSERT ON ORDERS
  4
  5  FOR EACH ROW
  6
  7  DECLARE
  8
  9      v_stock NUMBER;
 10
 11  BEGIN
 12
 13      SELECT STOCK_LEVEL INTO v_stock FROM ITEMS WHERE ITEM_ID = :NEW.ITEM_ID;
 14
 15      IF v_stock < :NEW.QUANTITY THEN
 16
 17          RAISE_APPLICATION_ERROR(-20001, 'Insufficient stock! Order cannot be placed.');
 18
 19      ELSE
 20
 21          UPDATE ITEMS SET STOCK_LEVEL = STOCK_LEVEL - :NEW.QUANTITY WHERE ITEM_ID = :NEW.ITEM_ID;
